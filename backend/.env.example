# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# CORS Settings
CORS_ORIGINS=*

# Camera Settings
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30

# LLM Provider (local, openai, claude)
DEFAULT_LLM_PROVIDER=local

# Local Model Settings
LOCAL_MODEL_NAME=Salesforce/blip-image-captioning-base
LOCAL_MODEL_DEVICE=cpu

# OpenAI API (optional - for better quality)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Claude API (optional - for better quality)
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Processing Settings
FRAME_PROCESS_INTERVAL=2
MAX_FRAME_QUEUE=100
